{
  "name": "@jason25417/dsh-composer-tweaks",
  "version": "0.2.0",
  "description": "Composer tweaks for DeepSeek Harness: mixed file/folder picker (macOS NSOpenPanel), GenUI prompt toggle in the plus menu, hidden GenUI button, Markdown source/view switch and user-message Markdown rendering.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "markdown.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "main": "index.js",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "composer",
    "markdown",
    "attachment",
    "file-picker",
    "genui"
  ],
  "license": "MIT",
  "author": "Jason Tu",
  "homepage": "https://github.com/Jason25417/dsh-composer-tweaks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason25417/dsh-composer-tweaks.git"
  },
  "bugs": {
    "url": "https://github.com/Jason25417/dsh-composer-tweaks/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
